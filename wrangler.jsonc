{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ikigai-finance-community",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "ai": { "binding": "AI" },
  "d1_databases": [
    { "binding": "DB", "database_name": "replace-me-database", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "r2_buckets": [
    { "binding": "EVIDENCE_BUCKET", "bucket_name": "replace-me-evidence" },
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "replace-me-cache" }
  ],
  "kv_namespaces": [
    { "binding": "PAIRING_KV", "id": "00000000000000000000000000000000" }
  ]
}
